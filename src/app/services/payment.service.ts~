// services/payment.service.ts
@Injectable({
    providedIn: 'root'
})
export class PaymentService {
    private apiUrl = 'api/payments';

    constructor(private http: HttpClient) {}

    getPayments(page: number, limit: number, status?: PaymentStatus, search?: string): Observable<any> {
        let params = new HttpParams()
            .set('page', page.toString())
            .set('limit', limit.toString());

        if (status) params = params.set('payment_status', status);
        if (search) params = params.set('search', search);

        return this.http.get<any>(this.apiUrl, { params });
    }

    uploadEvidence(paymentId: string, file: File): Observable<any> {
        const formData = new FormData();
        formData.append('file', file);
        return this.http.post(`${this.apiUrl}/${paymentId}/evidence`, formData);
    }

    updatePayment(paymentId: string, payment: Partial<Payment>): Observable<Payment> {
        return this.http.patch<Payment>(`${this.apiUrl}/${paymentId}`, payment);
    }
}
